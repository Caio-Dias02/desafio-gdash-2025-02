# ========== MONGODB ==========
# MongoDB Atlas connection string (obter em https://www.mongodb.com/cloud/atlas)
# Formato: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/gdash

# ========== RABBITMQ ==========
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ========== JWT & AUTENTICAÇÃO ==========
JWT_SECRET=seu-jwt-secret-super-seguro-aqui

# ========== OPENWEATHER API ==========
# Obter chave em: https://openweathermap.org/api
# Free tier: 60 calls/minute, 1 million calls/month
OPENWEATHER_API_KEY=sua-openweather-api-key-aqui

# Cidade para coleta de dados climáticos
WEATHER_CITY=São Paulo

# ========== ANTHROPIC CLAUDE API ==========
# Obter chave em: https://console.anthropic.com
ANTHROPIC_API_KEY=sua-anthropic-api-key-aqui

# ========== USUÁRIO PADRÃO ==========
# Credenciais do usuário criado automaticamente na inicialização
DEFAULT_USER_EMAIL=admin@gdash.com
DEFAULT_USER_PASSWORD=123456

# ========== PYTHON COLLECTOR ==========
# Intervalo de coleta em segundos (3600 = 1 hora)
COLLECTION_INTERVAL=3600

# ========== ENVIRONMENT ==========
NODE_ENV=development
